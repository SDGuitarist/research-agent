# Research Agent — environment configuration.
# Local dev: copy to `.env` and fill in real values (`cp .env.example .env`).
# Railway: set these as project-level Shared Variables referenced by BOTH services
# (${{shared.DATABASE_URL}}, ${{shared.ANTHROPIC_API_KEY}}, ${{shared.TAVILY_API_KEY}}).

# --- Postgres (required by web, worker, CLI, and MCP server) ---
# Use the Supabase SESSION pooler on port 5432 — NOT the 6543 transaction pooler.
# The direct db.<ref>.supabase.co host is IPv6-only and fails from Railway; the
# pooler host (aws-<region>.pooler.supabase.com) is IPv4-safe. If DATABASE_URL is
# missing, anything that touches Postgres fails fast with a clear message.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres

# --- Anthropic (required by the worker to run research + critiques; also CLI/MCP) ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# --- Tavily (primary web search; DuckDuckGo is the fallback). Required by the worker ---
TAVILY_API_KEY=your-tavily-api-key-here

# --- Optional ---
# The web service binds $PORT (Railway sets it automatically); defaults to 8000 locally.
# PORT=8000
